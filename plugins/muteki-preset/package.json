{
  "name": "muteki-preset",
  "version": "1.13.0",
  "description": "Muteki 蜂群预设本体：多会话事实图作战模式（黑板 + 派单编排 + 证据捕获）。market 安装即得完整预设；首次启动自动铺设 muteki-board 技能与 ~/.dsh-muteki/config.json。工作台 UI 另装 muteki-workbench。",
  "repository": {
    "type": "git",
    "url": "https://github.com/liaty8/dsh-muteki-preset.git",
    "directory": "plugins/muteki-preset"
  },
  "type": "module",
  "main": "bootstrap.mjs",
  "exports": {
    ".": "./bootstrap.mjs",
    "./orchestrator": "./orchestrator.mjs",
    "./core": "./core.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": ["./cordis.patch.yml"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/dsh-persona": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/dsh-workflow-ptc": ">=0.2.2-rc.3 <0.2.3-0",
    "@deepseek-ai/dsh-tool-ralph": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "keywords": ["dsh", "dsh-plugin", "muteki", "ctf", "preset", "orchestrator"]
}